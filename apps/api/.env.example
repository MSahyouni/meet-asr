# ==============================================================================
# Environment Configuration for meet-asr
# ==============================================================================
# Copy this file to .env and customize as needed
# NOTE: The application will function without a .env file using defaults
# Paths below are relative to the project root (meet-asr/), same as config.py BASE_DIR.
# Docker Compose uses the root .env.example.

# ==============================================================================
# General Settings
# ==============================================================================
ASR_DATA_DIR=data                          # Relative to project root (models, outputs, RAG, etc.)
ASR_ENV=development                        # Environment: development or production
API_TOKEN=                                 # Optional API token for authentication
BASE_URL=http://localhost:8000             # Base URL for API (used in emails, export links, etc.)
ASR_ALLOWED_ORIGINS=http://localhost:8000  # CORS allowed origins (comma-separated; use explicit values in production)
MAX_UPLOAD_MB=50                           # Max file upload size in MB
LOG_LEVEL=INFO                             # Application log level: DEBUG, INFO, WARNING, ERROR

# ==============================================================================
# ASR (Automatic Speech Recognition) Settings
# ==============================================================================
ASR_WARMUP=0                               # Pre-load Whisper model on startup (1=true, 0=false)
WHISPER_MODEL=heavy                        # Model size: light (base), medium, heavy (large-v3)
WHISPER_DEVICE=cuda                        # Device: cuda (GPU) or cpu
WHISPER_COMPUTE=int8                      # CUDA: int8 (safe for 6–8GB VRAM) | float16 (needs ~8GB+) | CPU: int8_float32
GPU_ID=0                                   # GPU device ID (if multiple GPUs)
ENHANCE_MODE=off                           # Audio enhancement: off, light (normalize+highpass), full (noise-reduce+filters)
ENHANCE_LEVEL=strong                       # Enhancement strength: light, medium, strong, aggressive
ASR_LOG_LOAD=1                             # Log model loading info (1=true, 0=false)
FFMPEG_PATH=                               # Optional explicit path to ffmpeg.exe (Windows)

# ==============================================================================
# TTS (Habibi فقط)
# ==============================================================================
TTS_PREPROCESS_ENABLED=1                   # Arabic preprocessing (normalize, numbers-to-words, etc.)
TTS_DIACRITIZE=0                           # Not used with Habibi (tashkeel stripped internally)
# Habibi long-form chunk size (UTF-8 bytes, ~2 Arabic lines). Smaller = more stable quality.
# HABIBI_MAX_CHUNK_CHARS=110
# HABIBI_NFE_STEP=32                        # diffusion steps (empty = auto: 16 CPU / 32 GPU)

# ==============================================================================
# NLP Settings (Summarization, NER, etc.)
# ==============================================================================
# Summarization: Jais-2 only (no lite/ultra modes)
# On switch delete matching subdir under data/models/summarizers/ then restart.
JAIS_MODEL=inceptionai/Jais-2-8B-Chat
JAIS_4BIT=1                               # 4-bit quantization (1=true, 0=false)
JAIS_TRUST_REMOTE=1                       # Trust remote code in transformers
JAIS_PROMPT_MODE=meeting                  # meeting|auto|balanced|concise
JAIS_ALLOW_DOWNLOAD=0                     # 0=offline-only; 1=allow HF download
HF_DEVICE_ID=-1                            # Device ID for transformers pipeline (-1=auto)
SUM_MAX_INPUT_TOKENS=800                   # Max input tokens per summarization chunk (map-reduce)
SUM_MAX_PARTS=8                            # Max parts for long-text summarization
SUM_RELEASE_ASR_GPU=1                      # Unload Whisper/Pyannote from VRAM before loading summarizer
SUM_WARM_JAIS=1                            # After ASR finishes, preload Jais-2 so first summarize is faster
DOWNLOAD_MAX_WORKERS=8                     # Parallel HF download workers for model fetch
HF_HUB_ENABLE_HF_TRANSFER=0                # 0=more reliable resume; 1=faster but can stall
PUNCT_MODEL=data/models/punctuation/arabic_punct  # Punctuation model (path or HF ID). If missing locally, falls back to makdadTaleb/arabic-punctuation-arabert
NER_MODEL=data/models/ner/arabic_ner             # NER model (path or HF ID)

# ==============================================================================
# RAG (Retrieval-Augmented Generation) Settings
# ==============================================================================
RAG_ENABLE=0                               # Enable RAG feature (1=true, 0=false)
RAG_EMB_MODEL=data/models/multilingual-e5-base  # Embedding model for RAG (prefer local path)
RAG_CHUNK_SIZE=1000                        # Text chunk size in characters
RAG_CHUNK_OVERLAP=150                      # Overlap between chunks
RAG_BATCH=64                               # Batch size for encoding (reduce to ~32 on low-memory CPU)
RAG_CHECK_EVERY=5000                       # Save index every N chunks
RAG_USE_GPU=auto                           # Use GPU: auto, 1 (force GPU), 0 (force CPU)

# ==============================================================================
# Hugging Face Settings
# ==============================================================================
# NOTE: Models are cached in data/models/ automatically
# DO NOT modify HF_HOME unless you have a specific reason
HF_TOKEN=                                  # HF token for accessing private models (optional)
DOWNLOAD_RETRY_FOREVER=1                   # Keep retrying model downloads until success
DOWNLOAD_RETRY_BASE_SEC=5                  # Initial retry wait seconds
DOWNLOAD_RETRY_MAX_SEC=60                  # Maximum retry wait seconds (backoff cap)
DOWNLOAD_MAX_WORKERS=1                     # Parallel HF downloads (1 = more stable on slow networks)

# ==============================================================================
# Auth & JWT Settings
# ==============================================================================
JWT_SECRET=change-me-very-strong-secret    # REQUIRED: >=32 chars random secret (rejected in production if weak)
JWT_EXPIRES_SECONDS=86400                  # Access token lifetime
JWT_ISSUER=meet-asr                        # JWT issuer claim
JWT_AUDIENCE=meet-asr-api                  # JWT audience claim
ADMIN_EMAILS=admin@local                   # Comma-separated admin emails

# ==============================================================================
# Output & Cleanup Settings
# ==============================================================================
OUTPUTS_MAX_GB=5                           # Max disk usage for outputs/ directory (GB)
CLEANUP_ENABLED=1                          # Enable auto-deletion of old files (1=true, 0=false)
CLEANUP_MAX_AGE_HOURS=24                   # Delete files older than this (hours)
CLEANUP_INTERVAL_HOURS=24                  # Check for cleanup every N hours
TFIDF_MAX_ROWS=140000                      # TF-IDF max rows for keywords

# ==============================================================================
# Transcribe Queue Settings
# ==============================================================================
TRANSCRIBE_MAX_QUEUED=20                   # Max queued transcribe jobs
TRANSCRIBE_MAX_CONCURRENT=2                # Max concurrent transcribe jobs

# ==============================================================================
# Verbosity
# ==============================================================================
TRANSFORMERS_VERBOSITY=error               # Transformers library verbosity: error, warning, info, debug
