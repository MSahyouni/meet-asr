# ======================================================================
# meet-asr — Root Environment Template (.env)
# ======================================================================
# Copy to .env in project root and customize.
# Used directly by docker-compose*.yml.
# Paths below use data/ (container: /app/data).

# ======================================================================
# General / API
# ======================================================================
ASR_ENV=development
API_TOKEN=
BASE_URL=http://localhost:8000
ASR_ALLOWED_ORIGINS=http://localhost:8000
MAX_UPLOAD_MB=50
ASR_DATA_DIR=data
ASR_WARMUP=0
LOG_LEVEL=INFO

# ======================================================================
# ASR (Whisper)
# ======================================================================
WHISPER_MODEL=heavy
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8
GPU_ID=0
ENHANCE_MODE=off
ENHANCE_LEVEL=strong
ASR_LOG_LOAD=1
FFMPEG_PATH=

# ======================================================================
# NLP / Summarization
# ======================================================================
SUMMARIZER_MODEL=data/models/summarizers/mT5_XLSum
# Ultra-only. Preferred: inceptionai/Jais-2-8B-Chat (gated). Open fallback: QCRI/Fanar-1-9B-Instruct
ULTRA_MODEL=inceptionai/Jais-2-8B-Chat
ULTRA_4BIT=1
ULTRA_TRUST_REMOTE=1
ULTRA_PROMPT_MODE=meeting
ULTRA_ALLOW_DOWNLOAD=1
HF_DEVICE_ID=-1
SUM_MAX_INPUT_TOKENS=800
SUM_MAX_PARTS=8
SUM_RELEASE_ASR_GPU=1
SUM_WARM_ULTRA=1
DOWNLOAD_MAX_WORKERS=8
HF_HUB_ENABLE_HF_TRANSFER=0
PUNCT_MODEL=data/models/punctuation/arabic_punct
NER_MODEL=data/models/ner/arabic_ner

# ======================================================================
# RAG
# ======================================================================
RAG_ENABLE=0
RAG_EMB_MODEL=data/models/multilingual-e5-base
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_BATCH=64
RAG_CHECK_EVERY=5000
RAG_USE_GPU=auto

# ======================================================================
# TTS
# ======================================================================
TTS_PREPROCESS_ENABLED=1
TTS_MMS_ENABLED=1
TTS_DIACRITIZE=0                           # Arabic tashkeel (.venv/bin/pip install mishkal, then set to 1)
# HABIBI_MAX_CHUNK_CHARS=110               # Habibi long-form UTF-8 byte cap per batch
# HABIBI_NFE_STEP=32
OMNIVOICE_TIMEOUT_SEC=7200                 # OmniVoice CLI timeout (0 = unlimited)
# OMNIVOICE_INFER_BIN=.tools/omnivoice/.venv/bin/omnivoice-infer

# ======================================================================
# Hugging Face / Downloads
# ======================================================================
HF_TOKEN=
DOWNLOAD_RETRY_FOREVER=1
DOWNLOAD_RETRY_BASE_SEC=5
DOWNLOAD_RETRY_MAX_SEC=60
DOWNLOAD_MAX_WORKERS=1

# ======================================================================
# Auth / JWT
# ======================================================================
JWT_SECRET=change-me-very-strong-secret
# Must be a strong random secret (>=32 chars). Weak/default values are rejected when ASR_ENV=production.
JWT_EXPIRES_SECONDS=86400
JWT_ISSUER=meet-asr
JWT_AUDIENCE=meet-asr-api
ADMIN_EMAILS=admin@local

# ======================================================================
# Cleanup / Outputs
# ======================================================================
OUTPUTS_MAX_GB=5
CLEANUP_ENABLED=1
CLEANUP_MAX_AGE_HOURS=24
CLEANUP_INTERVAL_HOURS=24
TFIDF_MAX_ROWS=140000

# ======================================================================
# Queue / Concurrency
# ======================================================================
TRANSCRIBE_MAX_QUEUED=20
TRANSCRIBE_MAX_CONCURRENT=2

# Optional library verbosity
TRANSFORMERS_VERBOSITY=error
