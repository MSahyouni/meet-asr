# meet-asr — مثال إعدادات البيئة
# انسخ إلى .env وعدّل القيم (cp .env.example .env)

# ======================
# API
# ======================
# API_TOKEN=
# ASR_ALLOWED_ORIGINS=*
# BASE_URL=http://127.0.0.1:8000
# MAX_UPLOAD_MB=50

# ======================
# Whisper (ASR)
# ======================
# WHISPER_MODEL=light
# WHISPER_MODEL=medium
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE=float16
# GPU_ID=0
# CPU_THREADS=4
# ENHANCE_MODE=off
# ASR_WARMUP=0

# ======================
# مسارات
# ======================
# ASR_DATA_DIR=data

# ======================
# Hugging Face (نماذج خاصة / جالي)
# ======================
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxx

# ======================
# NLP / تلخيص
# ======================
# SUMMARIZER_MODEL=csebuetnlp/mT5_multilingual_XLSum
# SUM_MAX_INPUT_TOKENS=800
# SUM_MAX_PARTS=8

# ======================
# TTS
# ======================
# TTS_MMS_ENABLED=1
# TTS_PREPROCESS_ENABLED=1

# ======================
# التنظيف الدوري
# ======================
# CLEANUP_ENABLED=1
# CLEANUP_MAX_AGE_HOURS=24
# CLEANUP_INTERVAL_HOURS=24

# ======================
# سجلات
# ======================
# LOG_LEVEL=INFO
